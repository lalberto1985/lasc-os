#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

lasc_clear_screen() {
    if [ -t 0 ] && [ -t 1 ]; then
        clear 2>/dev/null || :
    fi
}

lasc_pause() {
    printf '\n\033[1;32mPressione ENTER para continuar...\033[0m'
    IFS= read -r _
    printf '\n'
}

lasc_find_command() {
    command_name=$1

    if command -v "$command_name" >/dev/null 2>&1; then
        command -v "$command_name"
        return 0
    fi

    if [ -x "$SCRIPT_DIR/$command_name" ]; then
        printf '%s\n' "$SCRIPT_DIR/$command_name"
        return 0
    fi

    return 1
}

lasc_run_command() {
    command_name=$1

    if command_path=$(lasc_find_command "$command_name"); then
        "$command_path"
        return $?
    fi

    printf '\n\033[1;31m✗ Comando %s não encontrado.\033[0m\n' "$command_name" >&2
    return 127
}

lasc_run_tool() {
    command_name=$1
    label=$2

    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf '\n\033[1;31m✗ %s não está instalado.\033[0m\n' "$label"
        lasc_pause
        return 1
    fi

    "$command_name"
}

lasc_confirm_update() {
    printf '\nA atualização poderá modificar pacotes do sistema.\n'
    printf 'Continuar com a atualização? [s/N] '

    if ! IFS= read -r answer; then
        printf '\nAtualização cancelada.\n'
        return 1
    fi

    case "$answer" in
        s|S|sim|SIM|Sim)
            return 0
            ;;
        *)
            printf '\nAtualização cancelada. Nenhuma alteração realizada.\n'
            return 1
            ;;
    esac
}

while true; do
    lasc_clear_screen

    printf '\033[1;36m╔═══════════════════════════════════════╗\033[0m\n'
    printf '\033[1;36m║          \033[1;32mLASC OS STORE\033[1;36m                 ║\033[0m\n'
    printf '\033[1;36m╚═══════════════════════════════════════╝\033[0m\n\n'

    printf '\033[1;33m[1]\033[0m Sistema Info      (lasc-info)\n'
    printf '\033[1;33m[2]\033[0m Sistema Fetch     (lasc-fetch)\n'
    printf '\033[1;33m[3]\033[0m Instalar Apps     (lasc-apps)\n'
    printf '\033[1;33m[4]\033[0m Atualizar Sistema (lasc-update)\n'
    printf '\033[1;33m[5]\033[0m Monitor Processos (htop)\n'
    printf '\033[1;33m[6]\033[0m Editor de Texto   (vim)\n'
    printf '\033[1;33m[7]\033[0m Diagnóstico       (lasc-doctor)\n'
    printf '\033[1;33m[8]\033[0m Limpeza Sistema   (lasc-clean)\n'
    printf '\033[1;33m[9]\033[0m Sobre o Sistema   (lasc-about)\n'
    printf '\033[1;33m[0]\033[0m Sair\n\n'

    printf '\033[1;35mEscolha uma opção:\033[0m '

    if ! IFS= read -r choice; then
        printf '\nAté logo! 🚀\n'
        exit 0
    fi

    case "$choice" in
        1)
            lasc_run_command lasc-info
            lasc_pause
            ;;

        2)
            lasc_run_command lasc-fetch
            lasc_pause
            ;;

        3)
            lasc_run_command lasc-apps
            lasc_pause
            ;;

        4)
            if lasc_confirm_update; then
                lasc_run_command lasc-update
            fi
            lasc_pause
            ;;

        5)
            lasc_run_tool htop "Htop"
            ;;

        6)
            lasc_run_tool vim "Vim"
            ;;

        7)
            lasc_run_command lasc-doctor
            lasc_pause
            ;;

        8)
            lasc_run_command lasc-clean
            lasc_pause
            ;;

        9)
            lasc_run_command lasc-about
            lasc_pause
            ;;

        0)
            lasc_clear_screen
            printf '\033[1;32mAté logo! 🚀\033[0m\n'
            exit 0
            ;;

        *)
            printf '\n\033[1;31mOpção inválida!\033[0m\n'
            sleep 1
            ;;
    esac
done
