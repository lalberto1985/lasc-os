#!/bin/sh

while true; do
    clear
    printf "\033[1;36m╔═══════════════════════════════════════╗\033[0m\n"
    printf "\033[1;36m║          \033[1;32mLASC OS STORE\033[1;36m                 ║\033[0m\n"
    printf "\033[1;36m╚═══════════════════════════════════════╝\033[0m\n\n"
    printf "\033[1;33m[1]\033[0m Sistema Info      (lasc-info)\n"
    printf "\033[1;33m[2]\033[0m Sistema Fetch     (lasc-fetch)\n"
    printf "\033[1;33m[3]\033[0m Instalar Apps     (lasc-apps)\n"
    printf "\033[1;33m[4]\033[0m Atualizar Sistema (lasc-update)\n"
    printf "\033[1;33m[5]\033[0m Monitor Processos (htop)\n"
    printf "\033[1;33m[6]\033[0m Editor de Texto   (vim)\n"
    printf "\033[1;33m[7]\033[0m Diagnóstico       (lasc-doctor)\n"
    printf "\033[1;33m[8]\033[0m Limpeza Sistema   (lasc-clean)\n"
    printf "\033[1;33m[9]\033[0m Sobre o Sistema   (lasc-about)\n"
    printf "\033[1;33m[0]\033[0m Sair\n\n"
    printf "\033[1;35mEscolha uma opção:\033[0m "
    read -r choice
    
    case $choice in
        1) lasc-info; printf "\n\033[1;32mPressione ENTER para continuar...\033[0m"; read ;;
        2) lasc-fetch; printf "\n\033[1;32mPressione ENTER para continuar...\033[0m"; read ;;
        3) lasc-apps; printf "\n\033[1;32mPressione ENTER para continuar...\033[0m"; read ;;
        4) lasc-update; printf "\n\033[1;32mPressione ENTER para continuar...\033[0m"; read ;;
        5) htop ;;
        6) vim ;;
        7) lasc-doctor; printf "\n\033[1;32mPressione ENTER para continuar...\033[0m"; read ;;
        8) lasc-clean; printf "\n\033[1;32mPressione ENTER para continuar...\033[0m"; read ;;
        9) lasc-about; printf "\n\033[1;32mPressione ENTER para continuar...\033[0m"; read ;;
        0) clear; printf "\033[1;32mAté logo! 🚀\033[0m\n"; exit 0 ;;
        *) printf "\033[1;31mOpção inválida!\033[0m\n"; sleep 2 ;;
    esac
done
