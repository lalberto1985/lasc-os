#!/bin/sh

lasc_app_status() {
    command_name=$1
    label=$2

    if command -v "$command_name" >/dev/null 2>&1; then
        printf '   \033[1;32m✓\033[0m %s\n' "$label"
    else
        printf '   \033[1;31m✗\033[0m %s\n' "$label"
    fi
}

clear 2>/dev/null || :

printf '\033[1;36m╔═══════════════════════════════════════════════╗\033[0m\n'
printf '\033[1;36m║     \033[1;32mLASC OS - Apps Instalados\033[1;36m                 ║\033[0m\n'
printf '\033[1;36m╚═══════════════════════════════════════════════╝\033[0m\n\n'

printf '\033[1;33m📱 COMUNICAÇÃO:\033[0m\n'
lasc_app_status firefox-esr "Firefox"
lasc_app_status telegram-desktop "Telegram"
lasc_app_status geary "Geary (Email)"

printf '\n\033[1;33m🎵 MÍDIA:\033[0m\n'
lasc_app_status lollypop "Lollypop (Música)"
lasc_app_status celluloid "Celluloid (Vídeo)"
lasc_app_status eog "Eye of GNOME (Imagens)"

printf '\n\033[1;33m📝 PRODUTIVIDADE:\033[0m\n'
lasc_app_status gnome-text-editor "Editor de Texto"
lasc_app_status gnome-calculator "Calculadora"
lasc_app_status gnome-calendar "Calendário"
lasc_app_status gnome-contacts "Contatos"
lasc_app_status evince "Leitor PDF"

printf '\n\033[1;33m🔧 DESENVOLVIMENTO:\033[0m\n'
lasc_app_status git "Git"
lasc_app_status python3 "Python 3"
lasc_app_status node "Node.js"
lasc_app_status vim "Vim"
lasc_app_status htop "Htop"

printf '\n'
