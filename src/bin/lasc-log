#!/bin/sh

clear
echo -e "\033[1;36m╔═══════════════════════════════════════╗\033[0m"
echo -e "\033[1;36m║    LASC OS - Visualizador de Logs     ║\033[0m"
echo -e "\033[1;36m╚═══════════════════════════════════════╝\033[0m"
echo -e ""

echo -e "\033[1;33m📋 ÚLTIMOS LOGS DO SISTEMA:\033[0m"
echo -e ""

# Últimas 20 linhas do journal
if command -v journalctl >/dev/null 2>&1; then
    journalctl -n 20 --no-pager 2>/dev/null | tail -10
else
    dmesg | tail -10
fi

echo -e ""
echo -e "\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e ""
echo -e "\033[1;36m💡 Comandos úteis:\033[0m"
echo -e "   \033[1;32mjournalctl -f\033[0m        - Seguir logs em tempo real"
echo -e "   \033[1;32mjournalctl -p err\033[0m    - Apenas erros"
echo -e "   \033[1;32mdmesg\033[0m                - Logs do kernel"
echo -e ""
