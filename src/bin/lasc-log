#!/bin/sh

lasc_show_logs() {
    if command -v journalctl >/dev/null 2>&1; then
        journalctl -n 10 --no-pager 2>/dev/null
        return
    fi

    if command -v dmesg >/dev/null 2>&1; then
        dmesg 2>/dev/null | tail -10
        return
    fi

    printf '   Nenhuma fonte de logs disponível.\n'
}

clear 2>/dev/null || :

printf '\033[1;36m╔═══════════════════════════════════════╗\033[0m\n'
printf '\033[1;36m║    LASC OS - Visualizador de Logs     ║\033[0m\n'
printf '\033[1;36m╚═══════════════════════════════════════╝\033[0m\n\n'

printf '\033[1;33m📋 ÚLTIMOS LOGS DO SISTEMA:\033[0m\n\n'

lasc_show_logs

printf '\n\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n\n'

printf '\033[1;36m💡 Comandos úteis:\033[0m\n'
printf '   \033[1;32mjournalctl -f\033[0m        - Seguir logs em tempo real\n'
printf '   \033[1;32mjournalctl -p err\033[0m    - Apenas erros\n'
printf '   \033[1;32mdmesg\033[0m                - Logs do kernel\n\n'
