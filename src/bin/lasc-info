#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

if [ -r /usr/lib/lasc-os/version.sh ] && [ -r /usr/lib/lasc-os/system.sh ]; then
    . /usr/lib/lasc-os/version.sh
    . /usr/lib/lasc-os/system.sh
elif [ -r "$SCRIPT_DIR/../lib/lasc/version.sh" ] && [ -r "$SCRIPT_DIR/../lib/lasc/system.sh" ]; then
    . "$SCRIPT_DIR/../lib/lasc/version.sh"
    . "$SCRIPT_DIR/../lib/lasc/system.sh"
else
    printf '%s\n' "Erro: bibliotecas do LASC OS não encontradas." >&2
    exit 1
fi

LASC_VERSION=$(lasc_detect_version)
LASC_BASE=$(lasc_detect_base)
LASC_KERNEL=$(lasc_kernel)
LASC_UPTIME=$(lasc_uptime)
LASC_MEMORY=$(lasc_memory)
LASC_DISK=$(lasc_disk)
LASC_PROCESSES=$(lasc_process_count)

echo "╔═══════════════════════════════════════╗"
echo "║         LASC OS - Informações         ║"
echo "╚═══════════════════════════════════════╝"
echo ""
echo "Versão: $LASC_PRODUCT_NAME v$LASC_VERSION"
echo "Base: $LASC_BASE"
echo "Kernel: $LASC_KERNEL"
echo "Uptime: $LASC_UPTIME"
echo "Memória: $LASC_MEMORY"
echo "Disco: $LASC_DISK"
echo "Processos: $LASC_PROCESSES"
echo ""
echo "Desenvolvido por Luiz - $(date +%Y)"
echo "════════════════════════════════════════"
