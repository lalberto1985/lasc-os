#!/bin/sh
echo "╔═══════════════════════════════════════╗"
echo "║         LASC OS - Informações         ║"
echo "╚═══════════════════════════════════════╝"
echo ""
echo "Versão: LASC OS v1.0"
echo "Base: postmarketOS v25.12"
echo "Kernel: $(uname -r)"
echo "Uptime: $(uptime -p 2>/dev/null || uptime | awk '{print $3}')"
echo "Memória: $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
echo "Disco: $(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')"
echo "Processos: $(ps aux | wc -l)"
echo ""
echo "Desenvolvido por Luiz - $(date +%Y)"
echo "════════════════════════════════════════"
