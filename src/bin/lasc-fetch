#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

if [ -r /usr/lib/lasc-os/version.sh ] && [ -r /usr/lib/lasc-os/system.sh ]; then
    . /usr/lib/lasc-os/version.sh
    . /usr/lib/lasc-os/system.sh
elif [ -r "$SCRIPT_DIR/../lib/lasc/version.sh" ] && [ -r "$SCRIPT_DIR/../lib/lasc/system.sh" ]; then
    . "$SCRIPT_DIR/../lib/lasc/version.sh"
    . "$SCRIPT_DIR/../lib/lasc/system.sh"
else
    printf '%s\n' "Erro: bibliotecas do LASC OS não encontradas." >&2
    exit 1
fi

LASC_VERSION=$(lasc_detect_version)
OS="$LASC_PRODUCT_NAME v$LASC_VERSION"
KERNEL=$(lasc_kernel)
UPTIME=$(lasc_uptime)
MEMORY=$(lasc_memory)
DISK=$(lasc_disk)

USER_NAME=$(id -un 2>/dev/null || printf '%s\n' "${USER:-user}")
HOST_NAME=$(hostname 2>/dev/null || printf '%s\n' "lasc")
SHELL_NAME=$(basename "${SHELL:-sh}")

printf "\n"
printf "\033[1;36m╔═══════════════════════════════════════╗\033[0m\n"
printf "\033[1;36m║   \033[1;32m██╗      █████╗ ███████╗ ██████╗\033[1;36m    ║\033[0m\n"
printf "\033[1;36m║   \033[1;32m██║     ██╔══██╗██╔════╝██╔════╝\033[1;36m    ║\033[0m\n"
printf "\033[1;36m║   \033[1;32m██║     ███████║███████╗██║\033[1;36m         ║\033[0m\n"
printf "\033[1;36m║   \033[1;32m██║     ██╔══██║╚════██║██║\033[1;36m         ║\033[0m\n"
printf "\033[1;36m║   \033[1;32m███████╗██║  ██║███████║╚██████╗\033[1;36m    ║\033[0m\n"
printf "\033[1;36m║   \033[1;32m╚══════╝╚═╝  ╚═╝╚══════╝ ╚═════╝\033[1;36m    ║\033[0m\n"
printf "\033[1;36m╚═══════════════════════════════════════╝\033[0m\n\n"

printf "\033[1;35m%s\033[0m@\033[1;33m%s\033[0m\n" "$USER_NAME" "$HOST_NAME"
printf "\033[1;36m─────────────────────\033[0m\n"
printf "\033[1;35mOS:\033[0m       %s\n" "$OS"
printf "\033[1;35mKernel:\033[0m   %s\n" "$KERNEL"
printf "\033[1;35mUptime:\033[0m   %s\n" "$UPTIME"
printf "\033[1;35mShell:\033[0m    %s\n" "$SHELL_NAME"
printf "\033[1;35mMemory:\033[0m   %s\n" "$MEMORY"
printf "\033[1;35mDisk:\033[0m     %s\n" "$DISK"
printf "\n\033[1;32mDesenvolvido por Luiz AS Correa - %s\033[0m\n\n" "$(date +%Y)"
