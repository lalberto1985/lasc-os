#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

if [ -r /usr/lib/lasc-os/version.sh ] && [ -r /usr/lib/lasc-os/system.sh ]; then
    . /usr/lib/lasc-os/version.sh
    . /usr/lib/lasc-os/system.sh
elif [ -r "$SCRIPT_DIR/../lib/lasc/version.sh" ] && [ -r "$SCRIPT_DIR/../lib/lasc/system.sh" ]; then
    . "$SCRIPT_DIR/../lib/lasc/version.sh"
    . "$SCRIPT_DIR/../lib/lasc/system.sh"
else
    printf '%s\n' "Erro: bibliotecas do LASC OS não encontradas." >&2
    exit 1
fi

LASC_VERSION=$(lasc_detect_version)
LASC_UPTIME=$(lasc_uptime)
LASC_KERNEL=$(lasc_kernel)
LASC_PROCESSES=$(lasc_process_count)
LASC_MEMORY=$(lasc_memory)
LASC_MEMORY_PERCENT=$(lasc_memory_usage_percent 2>/dev/null || printf '%s\n' "unknown")
LASC_DISK=$(lasc_disk)

clear 2>/dev/null || :

printf '\n'
printf '\033[1;32m     ██╗      █████╗ ███████╗ ██████╗ \033[0m\n'
printf '\033[1;32m     ██║     ██╔══██╗██╔════╝██╔════╝ \033[0m\n'
printf '\033[1;32m     ██║     ███████║███████╗██║      \033[0m\n'
printf '\033[1;32m     ██║     ██╔══██║╚════██║██║      \033[0m\n'
printf '\033[1;32m     ███████╗██║  ██║███████║╚██████╗ \033[0m\n'
printf '\033[1;32m     ╚══════╝╚═╝  ╚═╝╚══════╝ ╚═════╝ \033[0m\n'
printf '\n'

printf '\033[1;36m        Sistema Operacional Mobile v%s\033[0m\n' "$LASC_VERSION"
printf '\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n\n'

# Data e hora
printf '\033[1;35m📅 %s\033[0m\n' "$(date '+%A, %d %B %Y')"
printf '\033[1;35m🕐 %s\033[0m\n\n' "$(date '+%H:%M:%S')"

# Status do sistema
printf '\033[1;33m⚡ SISTEMA\033[0m\n'
printf '   Uptime: %s\n' "$LASC_UPTIME"
printf '   Kernel: %s\n' "$LASC_KERNEL"
printf '   Processos: %s\n\n' "$LASC_PROCESSES"

# Recursos
printf '\033[1;33m💾 RECURSOS\033[0m\n'

if [ "$LASC_MEMORY_PERCENT" = "unknown" ]; then
    printf '   RAM: %s\n' "$LASC_MEMORY"
else
    printf '   RAM: %s (%s%%)\n' "$LASC_MEMORY" "$LASC_MEMORY_PERCENT"
fi

printf '   Disco: %s\n\n' "$LASC_DISK"

# Rede
printf '\033[1;33m🌐 REDE\033[0m\n'

if command -v ping >/dev/null 2>&1; then
    if ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1; then
        printf '   Status: \033[1;32m● Online\033[0m\n'
    else
        printf '   Status: \033[1;31m● Offline\033[0m\n'
    fi
else
    printf '   Status: \033[1;33m● Indisponível (ping não instalado)\033[0m\n'
fi

printf '\n\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n'

# Atalhos
printf '\n\033[1;36m⚡ Atalhos Rápidos:\033[0m\n'
printf '   \033[1;32mandroid\033[0m  - Menu principal de apps\n'
printf '   \033[1;32mstore\033[0m    - Loja de aplicativos\n'
printf '   \033[1;32mfetch\033[0m    - Informações do sistema\n'
printf '   \033[1;32mreadme\033[0m   - Documentação completa\n\n'
