#!/bin/sh

clear
echo -e ""
echo -e "\033[1;32m     ██╗      █████╗ ███████╗ ██████╗ \033[0m"
echo -e "\033[1;32m     ██║     ██╔══██╗██╔════╝██╔════╝ \033[0m"
echo -e "\033[1;32m     ██║     ███████║███████╗██║      \033[0m"
echo -e "\033[1;32m     ██║     ██╔══██║╚════██║██║      \033[0m"
echo -e "\033[1;32m     ███████╗██║  ██║███████║╚██████╗ \033[0m"
echo -e "\033[1;32m     ╚══════╝╚═╝  ╚═╝╚══════╝ ╚═════╝ \033[0m"
echo -e ""
echo -e "\033[1;36m        Sistema Operacional Mobile v1.0\033[0m"
echo -e "\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e ""

# Data e Hora
echo -e "\033[1;35m📅 $(date '+%A, %d %B %Y')\033[0m"
echo -e "\033[1;35m🕐 $(date '+%H:%M:%S')\033[0m"
echo -e ""

# Status do Sistema
echo -e "\033[1;33m⚡ SISTEMA\033[0m"
UPTIME=$(uptime | awk '{print $3}' | sed 's/,//')
KERNEL=$(uname -r)
PROCESSES=$(ps aux | wc -l)
echo -e "   Uptime: $UPTIME"
echo -e "   Kernel: $KERNEL"
echo -e "   Processos: $PROCESSES"
echo -e ""

# Recursos
echo -e "\033[1;33m💾 RECURSOS\033[0m"
RAM_USED=$(free -m | awk '/^Mem:/ {print $3}')
RAM_TOTAL=$(free -m | awk '/^Mem:/ {print $2}')
RAM_PERCENT=$((RAM_USED * 100 / RAM_TOTAL))
echo -e "   RAM: ${RAM_USED}MB / ${RAM_TOTAL}MB (${RAM_PERCENT}%)"

DISK_INFO=$(df -h / | awk 'NR==2 {print $3 " / " $2 " (" $5 ")"}')
echo -e "   Disco: $DISK_INFO"
echo -e ""

# Rede
echo -e "\033[1;33m🌐 REDE\033[0m"
if ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1; then
    echo -e "   Status: \033[1;32m● Online\033[0m"
else
    echo -e "   Status: \033[1;31m● Offline\033[0m"
fi

echo -e ""
echo -e "\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"

# Atalhos
echo -e ""
echo -e "\033[1;36m⚡ Atalhos Rápidos:\033[0m"
echo -e "   \033[1;32mandroid\033[0m  - Menu principal de apps"
echo -e "   \033[1;32mstore\033[0m    - Loja de aplicativos"
echo -e "   \033[1;32mfetch\033[0m    - Informações do sistema"
echo -e "   \033[1;32mreadme\033[0m   - Documentação completa"
echo -e ""
