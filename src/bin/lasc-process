#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

if [ -r /usr/lib/lasc-os/system.sh ]; then
    . /usr/lib/lasc-os/system.sh
elif [ -r "$SCRIPT_DIR/../lib/lasc/system.sh" ]; then
    . "$SCRIPT_DIR/../lib/lasc/system.sh"
else
    printf '%s\n' "Erro: biblioteca de sistema do LASC OS não encontrada." >&2
    exit 1
fi

lasc_process_state_count() (
    target_state=$1
    count=0

    for stat_file in /proc/[0-9]*/stat; do
        [ -r "$stat_file" ] || continue

        IFS= read -r stat_line < "$stat_file" || continue
        stat_rest=${stat_line##*) }
        state=${stat_rest%% *}

        if [ "$state" = "$target_state" ]; then
            count=$((count + 1))
        fi
    done

    printf '%s\n' "$count"
)

lasc_process_list() {
    for proc_dir in /proc/[0-9]*; do
        [ -d "$proc_dir" ] || continue

        pid=${proc_dir##*/}
        name=

        if [ -L "$proc_dir/exe" ]; then
            executable=$(readlink "$proc_dir/exe" 2>/dev/null || :)
            if [ -n "$executable" ]; then
                name=${executable##*/}
            fi
        fi

        if [ -z "$name" ] && [ -r "$proc_dir/comm" ]; then
            IFS= read -r name < "$proc_dir/comm" || name=
        fi

        [ -n "$name" ] || continue

        printf '%s\t%s\n' "$pid" "$name"
    done |
        sort -n |
        head -10 |
        awk -F '\t' '{printf "   %-7s %s\n", $1, $2}'
}

TOTAL=$(lasc_process_count)
RUNNING=$(lasc_process_state_count R)
SLEEPING=$(lasc_process_state_count S)

clear 2>/dev/null || :

printf '\033[1;36m╔═══════════════════════════════════════╗\033[0m\n'
printf '\033[1;36m║  LASC OS - Gerenciador de Processos   ║\033[0m\n'
printf '\033[1;36m╚═══════════════════════════════════════╝\033[0m\n\n'

printf '\033[1;33m📊 ESTATÍSTICAS:\033[0m\n'
printf '   Total:     \033[1;36m%s processos\033[0m\n' "$TOTAL"
printf '   Rodando:   \033[1;32m%s\033[0m\n' "$RUNNING"
printf '   Dormindo:  \033[1;35m%s\033[0m\n\n' "$SLEEPING"

printf '\033[1;33m🔥 PROCESSOS DO SISTEMA:\033[0m\n'
printf '   \033[1;35mPID     PROCESSO\033[0m\n'
lasc_process_list

printf '\n\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n\n'
printf '\033[1;36m💡 Para monitoramento detalhado use:\033[0m\n'
printf '   \033[1;32mhtop\033[0m - Monitor interativo completo\n\n'
