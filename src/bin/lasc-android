#!/bin/sh

while true; do
    clear
    printf "\033[1;36m╔═══════════════════════════════════════╗\033[0m\n"
    printf "\033[1;36m║       \033[1;32mLASC OS - Menu Principal\033[1;36m        ║\033[0m\n"
    printf "\033[1;36m╚═══════════════════════════════════════╝\033[0m\n\n"
    
    printf "\033[1;33m📱 COMUNICAÇÃO\033[0m\n"
    printf "[1] Firefox (Navegador)\n"
    printf "[2] Telegram (Mensagens)\n"
    printf "[3] Geary (Email)\n"
    
    printf "\n\033[1;33m🎵 MÍDIA\033[0m\n"
    printf "[4] Lollypop (Música)\n"
    printf "[5] Celluloid (Vídeo)\n"
    printf "[6] Imagens (Visualizador)\n"
    
    printf "\n\033[1;33m📝 PRODUTIVIDADE\033[0m\n"
    printf "[7] Editor de Texto\n"
    printf "[8] Calculadora\n"
    printf "[9] Calendário\n"
    printf "[10] PDF Reader\n"
    
    printf "\n\033[1;33m⚙️ SISTEMA\033[0m\n"
    printf "[11] Configurações (store)\n"
    printf "[12] Diagnóstico (doctor)\n"
    printf "[13] Limpeza (clean)\n"
    printf "[14] Sobre (about)\n"
    printf "[15] Monitor (htop)\n"
    
    printf "\n[0] Sair\n\n"
    printf "\033[1;35mEscolha:\033[0m "
    read -r choice
    
    case $choice in
        1) firefox & ;;
        2) telegram-desktop & ;;
        3) geary & ;;
        4) lollypop & ;;
        5) celluloid & ;;
        6) eog & ;;
        7) gnome-text-editor & ;;
        8) gnome-calculator & ;;
        9) gnome-calendar & ;;
        10) evince & ;;
        11) lasc-store ;;
        12) lasc-doctor; read -p "Pressione ENTER..." ;;
        13) lasc-clean; read -p "Pressione ENTER..." ;;
        14) lasc-about; read -p "Pressione ENTER..." ;;
        15) htop ;;
        0) clear; printf "\033[1;32mAté logo! 🚀\033[0m\n"; exit 0 ;;
        *) printf "\033[1;31mOpção inválida!\033[0m\n"; sleep 1 ;;
    esac
done
