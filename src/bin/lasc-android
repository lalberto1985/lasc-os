#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

lasc_clear_screen() {
    if [ -t 0 ] && [ -t 1 ]; then
        clear 2>/dev/null || :
    fi
}

lasc_pause() {
    printf '\n\033[1;32mPressione ENTER para continuar...\033[0m'
    IFS= read -r _
    printf '\n'
}

lasc_find_command() {
    command_name=$1

    if command -v "$command_name" >/dev/null 2>&1; then
        command -v "$command_name"
        return 0
    fi

    if [ -x "$SCRIPT_DIR/$command_name" ]; then
        printf '%s\n' "$SCRIPT_DIR/$command_name"
        return 0
    fi

    return 1
}

lasc_run_lasc_command() {
    command_name=$1

    if command_path=$(lasc_find_command "$command_name"); then
        "$command_path"
        return $?
    fi

    printf '\n\033[1;31m✗ Comando %s não encontrado.\033[0m\n' "$command_name" >&2
    return 127
}

lasc_launch_app() {
    command_name=$1
    label=$2

    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf '\n\033[1;31m✗ %s não está instalado.\033[0m\n' "$label"
        lasc_pause
        return 1
    fi

    "$command_name" >/dev/null 2>&1 &
    printf '\n\033[1;32m✓ %s iniciado.\033[0m\n' "$label"
    sleep 1
}

while true; do
    lasc_clear_screen

    printf '\033[1;36m╔═══════════════════════════════════════╗\033[0m\n'
    printf '\033[1;36m║       \033[1;32mLASC OS - Menu Principal\033[1;36m        ║\033[0m\n'
    printf '\033[1;36m╚═══════════════════════════════════════╝\033[0m\n\n'

    printf '\033[1;33m📱 COMUNICAÇÃO\033[0m\n'
    printf '[1] Firefox (Navegador)\n'
    printf '[2] Telegram (Mensagens)\n'
    printf '[3] Geary (Email)\n'

    printf '\n\033[1;33m🎵 MÍDIA\033[0m\n'
    printf '[4] Lollypop (Música)\n'
    printf '[5] Celluloid (Vídeo)\n'
    printf '[6] Imagens (Visualizador)\n'

    printf '\n\033[1;33m📝 PRODUTIVIDADE\033[0m\n'
    printf '[7] Editor de Texto\n'
    printf '[8] Calculadora\n'
    printf '[9] Calendário\n'
    printf '[10] PDF Reader\n'

    printf '\n\033[1;33m⚙️ SISTEMA\033[0m\n'
    printf '[11] Loja / Ferramentas (store)\n'
    printf '[12] Diagnóstico (doctor)\n'
    printf '[13] Limpeza (clean)\n'
    printf '[14] Sobre (about)\n'
    printf '[15] Monitor (htop)\n'

    printf '\n[0] Sair\n\n'
    printf '\033[1;35mEscolha:\033[0m '

    if ! IFS= read -r choice; then
        printf '\nAté logo! 🚀\n'
        exit 0
    fi

    case "$choice" in
        1) lasc_launch_app firefox-esr "Firefox" ;;
        2) lasc_launch_app telegram-desktop "Telegram" ;;
        3) lasc_launch_app geary "Geary" ;;
        4) lasc_launch_app lollypop "Lollypop" ;;
        5) lasc_launch_app celluloid "Celluloid" ;;
        6) lasc_launch_app eog "Visualizador de imagens" ;;
        7) lasc_launch_app gnome-text-editor "Editor de Texto" ;;
        8) lasc_launch_app gnome-calculator "Calculadora" ;;
        9) lasc_launch_app gnome-calendar "Calendário" ;;
        10) lasc_launch_app evince "Leitor PDF" ;;

        11)
            lasc_run_lasc_command lasc-store
            ;;

        12)
            lasc_run_lasc_command lasc-doctor
            lasc_pause
            ;;

        13)
            lasc_run_lasc_command lasc-clean
            lasc_pause
            ;;

        14)
            lasc_run_lasc_command lasc-about
            lasc_pause
            ;;

        15)
            if command -v htop >/dev/null 2>&1; then
                htop
            else
                printf '\n\033[1;31m✗ Htop não está instalado.\033[0m\n'
                lasc_pause
            fi
            ;;

        0)
            lasc_clear_screen
            printf '\033[1;32mAté logo! 🚀\033[0m\n'
            exit 0
            ;;

        *)
            printf '\n\033[1;31mOpção inválida!\033[0m\n'
            sleep 1
            ;;
    esac
done
