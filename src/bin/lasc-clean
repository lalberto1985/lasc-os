#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

if [ -r /usr/lib/lasc-os/privilege.sh ] &&
   [ -r /usr/lib/lasc-os/system.sh ]; then
    . /usr/lib/lasc-os/privilege.sh
    . /usr/lib/lasc-os/system.sh
elif [ -r "$SCRIPT_DIR/../lib/lasc/privilege.sh" ] &&
     [ -r "$SCRIPT_DIR/../lib/lasc/system.sh" ]; then
    . "$SCRIPT_DIR/../lib/lasc/privilege.sh"
    . "$SCRIPT_DIR/../lib/lasc/system.sh"
else
    printf '%s\n' "Erro: bibliotecas do LASC OS não encontradas." >&2
    exit 1
fi

DRY_RUN=0
ASSUME_YES=0

lasc_clean_usage() {
    printf 'Uso: lasc-clean [opções]\n\n'
    printf 'Opções:\n'
    printf '  --dry-run     Mostra o que seria limpo sem alterar o sistema\n'
    printf '  -y, --yes     Executa sem solicitar confirmação\n'
    printf '  -h, --help    Mostra esta ajuda\n'
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run)
            DRY_RUN=1
            ;;
        -y|--yes)
            ASSUME_YES=1
            ;;
        -h|--help)
            lasc_clean_usage
            exit 0
            ;;
        *)
            printf 'Erro: opção desconhecida: %s\n\n' "$1" >&2
            lasc_clean_usage >&2
            exit 2
            ;;
    esac

    shift
done

lasc_disk_used_kib() {
    df -Pk / 2>/dev/null |
        awk 'NR == 2 {print $3; exit}'
}

lasc_clean_apk_cache() {
    printf '\033[1;33m🧹 Cache de pacotes APK\033[0m\n'

    if ! command -v apk >/dev/null 2>&1; then
        printf '   \033[1;33m○ Ignorado: APK não está disponível.\033[0m\n'
        return 0
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        printf '   Seria executado: apk cache clean\n'
        return 0
    fi

    if lasc_run_as_root apk cache clean; then
        printf '   \033[1;32m✓ Cache do APK limpo.\033[0m\n'
        return 0
    fi

    printf '   \033[1;31m✗ Falha ao limpar o cache do APK.\033[0m\n' >&2
    return 1
}

lasc_clean_lasc_temp() {
    printf '\033[1;33m🧹 Arquivos temporários do LASC OS\033[0m\n'

    found=0

    for path in /tmp/lasc-* /tmp/LASC-*; do
        [ -e "$path" ] || continue

        found=1

        if [ "$DRY_RUN" -eq 1 ]; then
            printf '   Seria removido: %s\n' "$path"
            continue
        fi

        if lasc_run_as_root rm -rf -- "$path"; then
            printf '   \033[1;32m✓ Removido:\033[0m %s\n' "$path"
        else
            printf '   \033[1;31m✗ Falha ao remover:\033[0m %s\n' "$path" >&2
            return 1
        fi
    done

    if [ "$found" -eq 0 ]; then
        printf '   \033[1;32m✓ Nenhum temporário do LASC encontrado.\033[0m\n'
    fi

    return 0
}

lasc_clean_journal() {
    printf '\033[1;33m🧹 Logs antigos do systemd journal\033[0m\n'

    if ! command -v journalctl >/dev/null 2>&1; then
        printf '   \033[1;33m○ Ignorado: journalctl não está disponível.\033[0m\n'
        return 0
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        printf '   Seria executado: journalctl --vacuum-time=7d\n'
        return 0
    fi

    if lasc_run_as_root journalctl --vacuum-time=7d; then
        printf '   \033[1;32m✓ Logs anteriores a 7 dias tratados.\033[0m\n'
        return 0
    fi

    printf '   \033[1;31m✗ Falha ao limpar logs antigos.\033[0m\n' >&2
    return 1
}

clear 2>/dev/null || :

printf '\033[1;36m╔═══════════════════════════════════════╗\033[0m\n'
printf '\033[1;36m║    LASC OS - Limpeza do Sistema       ║\033[0m\n'
printf '\033[1;36m╚═══════════════════════════════════════╝\033[0m\n\n'

if [ "$DRY_RUN" -eq 1 ]; then
    printf '\033[1;35mMODO DE SIMULAÇÃO — nenhuma alteração será realizada.\033[0m\n\n'
elif [ "$ASSUME_YES" -ne 1 ]; then
    printf 'A limpeza poderá remover cache, temporários do LASC e logs antigos.\n'
    printf 'Continuar? [s/N] '

    if ! IFS= read -r answer; then
        printf '\nOperação cancelada.\n'
        exit 0
    fi

    case "$answer" in
        s|S|sim|SIM|Sim)
            ;;
        *)
            printf '\nOperação cancelada. Nenhuma alteração realizada.\n'
            exit 0
            ;;
    esac

    printf '\n'
fi

BEFORE=$(lasc_disk_used_kib)
FAILURES=0

lasc_clean_apk_cache || FAILURES=$((FAILURES + 1))
printf '\n'

lasc_clean_lasc_temp || FAILURES=$((FAILURES + 1))
printf '\n'

lasc_clean_journal || FAILURES=$((FAILURES + 1))

printf '\n\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n'

if [ "$DRY_RUN" -eq 1 ]; then
    printf '\033[1;36m✓ Simulação concluída. Nenhuma alteração foi realizada.\033[0m\n\n'
    exit 0
fi

AFTER=$(lasc_disk_used_kib)

if [ -n "$BEFORE" ] && [ -n "$AFTER" ] && [ "$BEFORE" -ge "$AFTER" ]; then
    FREED_KIB=$((BEFORE - AFTER))
    printf 'Espaço liberado: \033[1;36m%s\033[0m\n' "$(lasc_format_kib "$FREED_KIB")"
else
    printf 'Espaço liberado: não foi possível determinar\n'
fi

if [ "$FAILURES" -eq 0 ]; then
    printf '\033[1;32m✓ Limpeza concluída com sucesso.\033[0m\n\n'
    exit 0
fi

printf '\033[1;31m✗ Limpeza concluída com %s falha(s).\033[0m\n\n' "$FAILURES" >&2
exit 1
