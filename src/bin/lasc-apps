#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

if [ -r /usr/lib/lasc-os/privilege.sh ]; then
    . /usr/lib/lasc-os/privilege.sh
elif [ -r "$SCRIPT_DIR/../lib/lasc/privilege.sh" ]; then
    . "$SCRIPT_DIR/../lib/lasc/privilege.sh"
else
    printf '%s\n' "Erro: biblioteca de privilégios do LASC OS não encontrada." >&2
    exit 1
fi

lasc_install_packages() {
    label=$1
    shift

    printf '\nInstalando %s...\n' "$label"

    if lasc_run_as_root apk add "$@"; then
        printf '✓ %s instalado com sucesso.\n' "$label"
        INSTALL_COUNT=$((INSTALL_COUNT + 1))
        return 0
    fi

    printf '✗ Falha ao instalar %s.\n' "$label" >&2
    FAILURE_COUNT=$((FAILURE_COUNT + 1))
    return 1
}

clear 2>/dev/null || :

printf '╔═══════════════════════════════════════╗\n'
printf '║    LASC OS - Instalador de Apps       ║\n'
printf '╚═══════════════════════════════════════╝\n\n'

printf '📱 COMUNICAÇÃO:\n'
printf '1. Firefox - Navegador web\n'
printf '2. Telegram - Mensagens\n'
printf '3. Geary - Cliente de email\n\n'

printf '🎵 MÍDIA:\n'
printf '4. Lollypop - Player de música\n'
printf '5. Celluloid - Player de vídeo\n'
printf '6. Eye of GNOME - Visualizador de imagens\n\n'

printf '📝 PRODUTIVIDADE:\n'
printf '7. GNOME Text Editor - Editor de texto\n'
printf '8. GNOME Weather - Clima\n'
printf '9. Evince - Leitor de PDF\n'
printf '10. GNOME Calculator - Calculadora\n'
printf '11. GNOME Calendar - Calendário\n'
printf '12. GNOME Contacts - Contatos\n'
printf '13. GNOME Clocks - Relógio/Alarmes\n\n'

printf '🔧 DESENVOLVIMENTO:\n'
printf '14. Git - Controle de versão\n'
printf '15. Python 3 - Linguagem Python\n'
printf '16. Node.js - JavaScript runtime\n'
printf '17. Vim - Editor avançado\n'
printf '18. Htop - Monitor de processos\n\n'

printf 'Digite os números separados por espaço (ex: 1 2 4)\n'
printf "Digite 'TUDO' para instalar todos ou '0' para cancelar:\n"
printf '> '

if ! IFS= read -r apps; then
    printf '\nEntrada encerrada. Nenhuma alteração realizada.\n'
    exit 0
fi

case "$apps" in
    '')
        printf '\nNenhuma opção informada. Nenhuma alteração realizada.\n'
        exit 0
        ;;
    0)
        printf '\nInstalação cancelada. Nenhuma alteração realizada.\n'
        exit 0
        ;;
esac

if ! command -v apk >/dev/null 2>&1; then
    printf '\nErro: gerenciador de pacotes APK não encontrado.\n' >&2
    printf 'Este comando deve ser executado em Alpine Linux/postmarketOS.\n' >&2
    exit 1
fi

INSTALL_COUNT=0
FAILURE_COUNT=0
INVALID_COUNT=0

for app in $apps; do
    case "$app" in
        1)
            lasc_install_packages "Firefox" firefox-esr
            ;;
        2)
            lasc_install_packages "Telegram" telegram-desktop
            ;;
        3)
            lasc_install_packages "Geary" geary
            ;;
        4)
            lasc_install_packages "Lollypop" lollypop
            ;;
        5)
            lasc_install_packages "Celluloid" celluloid
            ;;
        6)
            lasc_install_packages "Eye of GNOME" eog
            ;;
        7)
            lasc_install_packages "GNOME Text Editor" gnome-text-editor
            ;;
        8)
            lasc_install_packages "GNOME Weather" gnome-weather
            ;;
        9)
            lasc_install_packages "Evince" evince
            ;;
        10)
            lasc_install_packages "GNOME Calculator" gnome-calculator
            ;;
        11)
            lasc_install_packages "GNOME Calendar" gnome-calendar
            ;;
        12)
            lasc_install_packages "GNOME Contacts" gnome-contacts
            ;;
        13)
            lasc_install_packages "GNOME Clocks" gnome-clocks
            ;;
        14)
            lasc_install_packages "Git" git
            ;;
        15)
            lasc_install_packages "Python 3" python3 py3-pip
            ;;
        16)
            lasc_install_packages "Node.js" nodejs npm
            ;;
        17)
            lasc_install_packages "Vim" vim
            ;;
        18)
            lasc_install_packages "Htop" htop
            ;;
        TUDO|tudo)
            lasc_install_packages \
                "todos os aplicativos" \
                firefox-esr \
                telegram-desktop \
                geary \
                lollypop \
                celluloid \
                eog \
                gnome-text-editor \
                gnome-weather \
                evince \
                gnome-calculator \
                gnome-calendar \
                gnome-contacts \
                gnome-clocks \
                git \
                python3 \
                py3-pip \
                nodejs \
                npm \
                vim \
                htop
            ;;
        *)
            printf 'Opção inválida: %s\n' "$app" >&2
            INVALID_COUNT=$((INVALID_COUNT + 1))
            ;;
    esac
done

printf '\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'

if [ "$FAILURE_COUNT" -eq 0 ] && [ "$INVALID_COUNT" -eq 0 ]; then
    printf '✓ Instalação concluída com sucesso.\n'
    exit 0
fi

printf 'Instalações concluídas: %s\n' "$INSTALL_COUNT"
printf 'Falhas: %s\n' "$FAILURE_COUNT"
printf 'Opções inválidas: %s\n' "$INVALID_COUNT"
printf '✗ A operação terminou com problemas.\n' >&2
exit 1
