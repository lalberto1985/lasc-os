#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

DRY_RUN=0

lasc_backup_usage() {
    printf 'Uso: lasc-backup [opções]\n\n'
    printf 'Opções:\n'
    printf '  --dry-run     Mostra o que seria incluído sem criar backup\n'
    printf '  -h, --help    Mostra esta ajuda\n'
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run)
            DRY_RUN=1
            ;;
        -h|--help)
            lasc_backup_usage
            exit 0
            ;;
        *)
            printf 'Erro: opção desconhecida: %s\n\n' "$1" >&2
            lasc_backup_usage >&2
            exit 2
            ;;
    esac

    shift
done

if [ -z "${HOME:-}" ]; then
    printf '%s\n' "Erro: variável HOME não está definida." >&2
    exit 1
fi

if ! command -v tar >/dev/null 2>&1; then
    printf '%s\n' "Erro: comando tar não encontrado." >&2
    exit 1
fi

BACKUP_DIR="$HOME/lasc-backups"
DATE=$(date '+%Y%m%d_%H%M%S')
BACKUP_FILE="$BACKUP_DIR/lasc_backup_$DATE.tar.gz"

SOURCE_ROOT=

if [ -r "$SCRIPT_DIR/../../VERSION" ] &&
   [ -d "$SCRIPT_DIR/../lib/lasc" ]; then
    SOURCE_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." 2>/dev/null && pwd)
fi

lasc_show_backup_plan() {
    found=0

    printf '\033[1;33mArquivos do usuário:\033[0m\n'

    for path in \
        "$HOME/.profile" \
        "$HOME/.bashrc" \
        "$HOME/LASC-README.md"
    do
        if [ -r "$path" ]; then
            printf '   \033[1;32m✓\033[0m %s\n' "$path"
            found=1
        fi
    done

    printf '\n\033[1;33mArquivos do LASC OS:\033[0m\n'

    if [ -n "$SOURCE_ROOT" ]; then
        printf '   Modo: código-fonte\n'

        for path in \
            "$SOURCE_ROOT/VERSION" \
            "$SOURCE_ROOT/src/bin" \
            "$SOURCE_ROOT/src/lib/lasc"
        do
            if [ -r "$path" ]; then
                printf '   \033[1;32m✓\033[0m %s\n' "$path"
                found=1
            fi
        done
    else
        printf '   Modo: instalação do sistema\n'

        for path in \
            /usr/share/lasc-os/VERSION \
            /usr/lib/lasc-os
        do
            if [ -r "$path" ]; then
                printf '   \033[1;32m✓\033[0m %s\n' "$path"
                found=1
            fi
        done

        installed_commands=0

        for path in /usr/bin/lasc-*; do
            [ -r "$path" ] || continue

            if [ "$installed_commands" -eq 0 ]; then
                printf '   \033[1;32m✓\033[0m /usr/bin/lasc-*\n'
            fi

            installed_commands=1
            found=1
        done
    fi

    return "$found"
}

clear 2>/dev/null || :

printf '\033[1;36m╔═══════════════════════════════════════╗\033[0m\n'
printf '\033[1;36m║      LASC OS - Sistema de Backup      ║\033[0m\n'
printf '\033[1;36m╚═══════════════════════════════════════╝\033[0m\n\n'

if [ "$DRY_RUN" -eq 1 ]; then
    printf '\033[1;35mMODO DE SIMULAÇÃO — nenhum arquivo será criado.\033[0m\n\n'
fi

lasc_show_backup_plan
PLAN_FOUND=$?

if [ "$PLAN_FOUND" -eq 0 ]; then
    printf '\nErro: nenhum arquivo elegível para backup foi encontrado.\n' >&2
    exit 1
fi

printf '\nDestino: %s\n' "$BACKUP_FILE"

if [ "$DRY_RUN" -eq 1 ]; then
    printf '\n\033[1;32m✓ Simulação concluída. Nenhum arquivo foi criado.\033[0m\n\n'
    exit 0
fi

umask 077

if ! mkdir -p "$BACKUP_DIR"; then
    printf 'Erro: não foi possível criar %s\n' "$BACKUP_DIR" >&2
    exit 1
fi

STAGING_DIR=$(mktemp -d "${TMPDIR:-/tmp}/lasc-backup.XXXXXX") || {
    printf '%s\n' "Erro: não foi possível criar diretório temporário." >&2
    exit 1
}

lasc_backup_cleanup() {
    rm -rf -- "$STAGING_DIR"
}

trap lasc_backup_cleanup EXIT HUP INT TERM

mkdir -p \
    "$STAGING_DIR/user" \
    "$STAGING_DIR/lasc"

for path in \
    "$HOME/.profile" \
    "$HOME/.bashrc" \
    "$HOME/LASC-README.md"
do
    [ -r "$path" ] || continue

    cp -p -- "$path" "$STAGING_DIR/user/" || {
        printf 'Erro: falha ao copiar %s\n' "$path" >&2
        exit 1
    }
done

if [ -n "$SOURCE_ROOT" ]; then
    cp -p -- "$SOURCE_ROOT/VERSION" "$STAGING_DIR/lasc/" || exit 1

    cp -R -- "$SOURCE_ROOT/src/bin" "$STAGING_DIR/lasc/" || exit 1
    cp -R -- "$SOURCE_ROOT/src/lib" "$STAGING_DIR/lasc/" || exit 1
else
    if [ -r /usr/share/lasc-os/VERSION ]; then
        cp -p -- /usr/share/lasc-os/VERSION "$STAGING_DIR/lasc/" || exit 1
    fi

    if [ -d /usr/lib/lasc-os ]; then
        cp -R -- /usr/lib/lasc-os "$STAGING_DIR/lasc/" || exit 1
    fi

    mkdir -p "$STAGING_DIR/lasc/bin"

    for path in /usr/bin/lasc-*; do
        [ -r "$path" ] || continue
        cp -p -- "$path" "$STAGING_DIR/lasc/bin/" || exit 1
    done
fi

if ! tar -czf "$BACKUP_FILE" -C "$STAGING_DIR" .; then
    printf '%s\n' "Erro: falha ao criar o arquivo de backup." >&2
    rm -f -- "$BACKUP_FILE"
    exit 1
fi

printf '\n\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n'
printf '\033[1;32m✓ Backup concluído com sucesso.\033[0m\n\n'
printf 'Arquivo: \033[1;36m%s\033[0m\n' "$BACKUP_FILE"

if command -v du >/dev/null 2>&1; then
    SIZE=$(du -h "$BACKUP_FILE" 2>/dev/null | awk '{print $1}')
    [ -n "$SIZE" ] && printf 'Tamanho: \033[1;36m%s\033[0m\n' "$SIZE"
fi

printf '\n'
