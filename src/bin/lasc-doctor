#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

if [ -r /usr/lib/lasc-os/system.sh ]; then
    . /usr/lib/lasc-os/system.sh
elif [ -r "$SCRIPT_DIR/../lib/lasc/system.sh" ]; then
    . "$SCRIPT_DIR/../lib/lasc/system.sh"
else
    printf '%s\n' "Erro: biblioteca de sistema do LASC OS não encontrada." >&2
    exit 1
fi

lasc_command_exists() {
    command -v "$1" >/dev/null 2>&1 || [ -x "$SCRIPT_DIR/$1" ]
}

clear 2>/dev/null || :

printf '\033[1;36m╔═══════════════════════════════════════╗\033[0m\n'
printf '\033[1;36m║     LASC OS - Diagnóstico do Sistema  ║\033[0m\n'
printf '\033[1;36m╚═══════════════════════════════════════╝\033[0m\n\n'

ISSUES=0
WARNINGS=0

# Espaço em disco
printf '\033[1;33m🔍 Verificando espaço em disco...\033[0m\n'

if DISK_USAGE=$(lasc_disk_usage_percent 2>/dev/null); then
    if [ "$DISK_USAGE" -gt 80 ]; then
        printf '   \033[1;31m✗ AVISO: Disco está %s%% cheio!\033[0m\n' "$DISK_USAGE"
        ISSUES=$((ISSUES + 1))
    else
        printf '   \033[1;32m✓ Espaço OK (%s%% usado)\033[0m\n' "$DISK_USAGE"
    fi
else
    printf '   \033[1;31m✗ Não foi possível determinar o uso do disco.\033[0m\n'
    ISSUES=$((ISSUES + 1))
fi

# Memória
printf '\033[1;33m🔍 Verificando memória...\033[0m\n'

if MEM_PERCENT=$(lasc_memory_usage_percent 2>/dev/null); then
    if [ "$MEM_PERCENT" -gt 90 ]; then
        printf '   \033[1;31m✗ AVISO: Memória está %s%% em uso!\033[0m\n' "$MEM_PERCENT"
        ISSUES=$((ISSUES + 1))
    else
        printf '   \033[1;32m✓ Memória OK (%s%% usada)\033[0m\n' "$MEM_PERCENT"
    fi
else
    printf '   \033[1;31m✗ Não foi possível determinar o uso da memória.\033[0m\n'
    ISSUES=$((ISSUES + 1))
fi

# Comandos LASC
printf '\033[1;33m🔍 Verificando comandos LASC...\033[0m\n'

COMMANDS="
lasc-about
lasc-android
lasc-apps
lasc-backup
lasc-clean
lasc-dashboard
lasc-doctor
lasc-fetch
lasc-help
lasc-info
lasc-list
lasc-log
lasc-network
lasc-process
lasc-store
lasc-update
lasc-version
"

for cmd in $COMMANDS; do
    if lasc_command_exists "$cmd"; then
        printf '   \033[1;32m✓\033[0m %s\n' "$cmd"
    else
        printf '   \033[1;31m✗ %s não encontrado!\033[0m\n' "$cmd"
        ISSUES=$((ISSUES + 1))
    fi
done

# Aplicações opcionais
printf '\033[1;33m🔍 Verificando aplicativos opcionais...\033[0m\n'

APPS="firefox-esr telegram-desktop htop git python3"

for app in $APPS; do
    if command -v "$app" >/dev/null 2>&1; then
        printf '   \033[1;32m✓\033[0m %s\n' "$app"
    else
        printf '   \033[1;33m⚠\033[0m %s não instalado\n' "$app"
        WARNINGS=$((WARNINGS + 1))
    fi
done

printf '\n\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n'

if [ "$ISSUES" -eq 0 ]; then
    printf '\033[1;32m✓ Sistema saudável! Nenhum problema crítico detectado.\033[0m\n'
else
    printf '\033[1;31m✗ %s problema(s) detectado(s).\033[0m\n' "$ISSUES"
fi

if [ "$WARNINGS" -gt 0 ]; then
    printf '\033[1;33m⚠ %s aviso(s) de aplicativo(s) opcional(is).\033[0m\n' "$WARNINGS"
fi

printf '\n'
